---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/assets/xgl-favicon.webp" />
    <title>Set Command Central Password | Expedition Growth Lab</title>
    <style>
      :root { font-family: Inter, system-ui, sans-serif; background:#0d1117; color:#f7f8fa; }
      * { box-sizing:border-box; }
      body { margin:0; min-height:100vh; display:grid; place-items:center; padding:1.5rem; }
      .panel { width:min(560px,100%); padding:2rem; border:1px solid #2a3545; border-radius:20px; background:#141a22; }
      h1 { margin:.4rem 0 1rem; font-size:2.2rem; }
      p, li { color:#aeb9c7; line-height:1.55; }
      ul { padding-left:1.2rem; }
      label { display:block; margin:1.25rem 0 .45rem; color:#cbd5e1; }
      input { width:100%; padding:.85rem 1rem; border-radius:10px; border:1px solid #354154; background:#0f141b; color:white; font:inherit; }
      button { margin-top:1.25rem; width:100%; padding:.9rem 1rem; border:0; border-radius:10px; background:#e9edf3; color:#10161d; font-weight:800; cursor:pointer; font:inherit; }
      button:disabled { opacity:.65; cursor:wait; }
      .status { margin-top:1rem; min-height:1.5rem; color:#a8d3ad; }
      .status.error { color:#efaaaa; }
      .eyebrow { text-transform:uppercase; letter-spacing:.17em; font-size:.75rem; color:#8494a7; }
      .requirements { margin:1rem 0 0; padding:1rem 1.1rem; border:1px solid #273241; border-radius:12px; background:#10161d; }
    </style>
  </head>
  <body>
    <main class="panel">
      <div class="eyebrow">One-time setup</div>
      <h1>Choose your password</h1>
      <p>This page sets the password for your authorized Command Central account. The setup link can only be used once.</p>

      <div class="requirements">
        <strong>Password requirements</strong>
        <ul>
          <li>At least 12 characters</li>
          <li>Uppercase and lowercase letters</li>
          <li>At least one number</li>
          <li>At least one symbol</li>
        </ul>
      </div>

      <form id="setup-form">
        <label for="password">New password</label>
        <input id="password" type="password" autocomplete="new-password" minlength="12" required />

        <label for="confirm-password">Confirm password</label>
        <input id="confirm-password" type="password" autocomplete="new-password" minlength="12" required />

        <button id="submit-button" type="submit">Save password</button>
      </form>

      <div id="status" class="status" aria-live="polite"></div>
    </main>

    <script>
      import { createBrowserClient } from '../../lib/supabase';

      const supabase = createBrowserClient();
      const form = document.querySelector('#setup-form');
      const status = document.querySelector('#status');
      const button = document.querySelector('#submit-button');
      const token = new URLSearchParams(window.location.search).get('token');

      if (!token && status) {
        status.classList.add('error');
        status.textContent = 'This setup link is missing its security token.';
        if (button) button.disabled = true;
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const password = document.querySelector('#password')?.value ?? '';
        const confirm = document.querySelector('#confirm-password')?.value ?? '';

        if (password !== confirm) {
          status?.classList.add('error');
          if (status) status.textContent = 'Those passwords do not match.';
          return;
        }

        if (!token) return;

        if (status) {
          status.classList.remove('error');
          status.textContent = 'Saving password…';
        }
        if (button) button.disabled = true;

        const { data, error } = await supabase.functions.invoke('command-central-set-password', {
          body: { token, password }
        });

        const message = error
          ? 'Password setup failed. The setup link may be invalid or expired.'
          : data?.error;

        if (message) {
          if (status) {
            status.classList.add('error');
            status.textContent = data?.error || message;
          }
          if (button) button.disabled = false;
          return;
        }

        window.location.assign('/command-central/login?setup=complete');
      });
    </script>
  </body>
</html>
