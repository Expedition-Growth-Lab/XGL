---
import { createPublicClient } from '../../lib/supabase';

const supabase = createPublicClient();
const { data, error } = await supabase
  .from('intelligence_items')
  .select('id,slug,headline,stream,public_desk,watchtower_category,summary,urgency,published_at,source_url,why_xgl_cares,public_body,geography')
  .eq('editorial_status','published')
  .not('headline','ilike','Review source change:%')
  .order('published_at',{ascending:false})
  .limit(100);

const items=(data??[]).filter((item)=>item.slug && item.headline && item.public_body);
const groups=[
  ['regulatory-watch','Regulatory Watch',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('regulatory')],
  ['public-lands-watch','Public Lands Watch',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('public lands')],
  ['builder-intelligence','Builder Intelligence',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('builder')],
  ['industry-headlines','Industry Headlines',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('industry')],
  ['emergency-response','Emergency Response',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('emergency')],
  ['inside-the-lab','Inside the Lab',(x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('inside')]
];
const formatPublished=(v)=>v?new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(new Date(v)):'';
const storyHref=(item)=>`/command-central/field-signal/${item.slug}`;
---
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <title>Field Signal | Command Central | Expedition Growth Lab</title>
  <link rel="icon" type="image/webp" href="/assets/xgl-favicon.webp">
  <link rel="stylesheet" href="/institutional.css">
  <link rel="stylesheet" href="/command-central.css">
</head>
<body class="command-central-app">
<header class="site-header"><div class="wrap"><a class="logo" href="/"><img src="/assets/xgl-txt-logo-clean.webp" alt="Expedition Growth Lab"></a><nav class="nav"><a href="/the-lab">The Lab</a><a class="active" href="/command-central">Command Central</a><a href="/one-rising-sun">One Rising Sun</a><a href="/faq">FAQ</a><a href="/about">About</a><a href="/contact">Contact</a></nav><a class="assessment-cta" href="/assessment">Start Assessment</a><details class="mobile-menu"><summary>Menu</summary><div class="mobile-menu-panel"><a href="/">Home</a><a href="/the-lab">The Lab</a><a href="/command-central">Command Central</a><a href="/command-central/field-signal">Field Signal</a><a href="/one-rising-sun">One Rising Sun</a><a href="/faq">FAQ</a><a href="/about">About</a><a href="/contact">Contact</a></div></details></div></header>

<main>
  <section class="hero cc-field-hero">
    <div class="wrap">
      <a class="cc-back" href="/command-central">← Back to Command Central</a>
      <div class="eyebrow">Field Signal</div>
      <h1 class="display">Meaning<br>before noise.</h1>
      <p class="hero-copy">The public output of the XGL Watchtower: verified developments, useful context, and the question that matters most—what does this mean for builders and the communities around them?</p>
    </div>
  </section>

  <section class="cc-foundation cc-story-index">
    <div class="wrap">
      <div class="cc-index-heading">
        <div>
          <div class="eyebrow gray">Latest intelligence</div>
          <h2>Published signals</h2>
        </div>
        <div class="cc-index-count">{items.length} public {items.length===1?'story':'stories'}</div>
      </div>

      {error && <div class="cc-empty">Command Central could not load the public story index.</div>}

      {!error && items.length===0
        ? <div class="cc-empty">No public Field Signals have been released yet. The Watchtower is active, but raw monitoring notes stay private until they are verified and rewritten into a public story.</div>
        : <div class="cc-story-list">
            {items.map((item)=>
              <article class="cc-story-result">
                <div class="cc-story-meta">
                  <span>{item.public_desk||item.stream||'Field Signal'}</span>
                  {item.geography&&<span>{item.geography}</span>}
                  {item.published_at&&<span>{formatPublished(item.published_at)}</span>}
                </div>
                <h3><a href={storyHref(item)}>{item.headline}</a></h3>
                {item.summary&&<p>{item.summary}</p>}
                <div class="cc-story-actions">
                  <a class="cc-read-story" href={storyHref(item)}>Read signal →</a>
                  {item.source_url&&<a class="cc-source-link" href={item.source_url} target="_blank" rel="noreferrer">Primary/source page ↗</a>}
                </div>
              </article>
            )}
          </div>
      }
    </div>
  </section>

  <section class="cc-desk-index">
    <div class="wrap">
      <div class="eyebrow gray">Browse by desk</div>
      <div class="cc-desk-index-grid">
        {groups.map(([id,label,test])=>{
          const matches=items.filter(test);
          return <a class="cc-desk-index-card" href={matches.length?`#${id}`:'/command-central'}>
            <span>{label}</span>
            <strong>{matches.length}</strong>
          </a>
        })}
      </div>
    </div>
  </section>

  {groups.map(([id,label,test])=>{
    const matches=items.filter(test);
    if(!matches.length) return null;
    return <section class="cc-story-desk" id={id}>
      <div class="wrap">
        <div class="cc-story-desk-head">
          <div>
            <div class="eyebrow gray">{label}</div>
            <h2>{label}</h2>
          </div>
          <span>{matches.length} {matches.length===1?'signal':'signals'}</span>
        </div>
        <div class="cc-story-list">
          {matches.map((item)=>
            <article class="cc-story-result">
              <div class="cc-story-meta">
                {item.geography&&<span>{item.geography}</span>}
                {item.published_at&&<span>{formatPublished(item.published_at)}</span>}
              </div>
              <h3><a href={storyHref(item)}>{item.headline}</a></h3>
              {item.summary&&<p>{item.summary}</p>}
              <div class="cc-story-actions">
                <a class="cc-read-story" href={storyHref(item)}>Read signal →</a>
              </div>
            </article>
          )}
        </div>
      </div>
    </section>
  })}
</main>

<footer class="footer"><div class="wrap footer-grid"><div><img class="footer-logo" src="/assets/xgl-txt-logo-clean.webp" alt="Expedition Growth Lab"><div class="footer-tagline">Protect the Build. Grow the Legacy.</div><div class="copyright">© 2026 Expedition Growth Lab LLC. Oregon, USA.</div></div><div><h4>Explore</h4><a href="/assessment">Growth Terrain Assessment</a><a href="/the-lab">The Lab</a><a href="/command-central">Command Central</a><a href="/command-central/field-signal">Field Signal</a><a href="/one-rising-sun">One Rising Sun</a></div><div><h4>Company</h4><a href="/about">About XGL</a><a href="/faq">FAQ</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div></footer>
<script src="/site.js" defer></script>
</body>
</html>
