---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Editorial Room | Expedition Growth Lab</title>
    <style>
      :root { font-family: Inter, system-ui, sans-serif; background:#0d1117; color:#f5f7fa; }
      * { box-sizing:border-box; }
      body { margin:0; min-height:100vh; }
      main { max-width:1400px; margin:auto; padding:2rem 1.25rem 5rem; }
      header { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:2rem; }
      h1 { margin:.25rem 0; font-size:clamp(2.4rem,5vw,4.5rem); letter-spacing:-.04em; }
      .eyebrow { text-transform:uppercase; letter-spacing:.16em; color:#8090a4; font-size:.75rem; }
      .muted { color:#97a6b8; }
      .toolbar { display:flex; gap:.65rem; flex-wrap:wrap; margin:1rem 0 1.5rem; }
      button { border:1px solid #3a4657; background:#171e27; color:#eef2f6; border-radius:10px; padding:.65rem .85rem; cursor:pointer; font-weight:700; }
      button.primary { background:#edf1f6; color:#10161d; border-color:#edf1f6; }
      button.danger { border-color:#714347; color:#ffced1; }
      button:disabled { opacity:.45; cursor:not-allowed; }
      .panel { border:1px solid #283444; background:#131a22; border-radius:18px; overflow:hidden; }
      .row { display:grid; grid-template-columns:150px minmax(260px,1.4fr) minmax(240px,1fr) 280px; gap:1rem; padding:1rem; border-top:1px solid #25303f; align-items:start; }
      .row:first-child { border-top:0; }
      .head { background:#10161d; color:#8fa0b4; text-transform:uppercase; letter-spacing:.08em; font-size:.75rem; }
      .headline { font-weight:800; line-height:1.3; }
      .small { font-size:.86rem; line-height:1.5; color:#aeb9c6; }
      .tag { display:inline-block; font-size:.74rem; border:1px solid #344155; border-radius:999px; padding:.25rem .48rem; margin:.15rem .2rem .15rem 0; color:#bac7d5; }
      .actions { display:flex; flex-wrap:wrap; gap:.4rem; }
      .state { margin:1rem 0; padding:.9rem 1rem; border-radius:12px; background:#141b24; border:1px solid #2a3545; }
      .hidden { display:none !important; }
      @media(max-width:900px){ .row { grid-template-columns:1fr; } .head { display:none; } }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div>
          <div class="eyebrow">Private XGL Back Office</div>
          <h1>Editorial Room</h1>
          <div class="muted">Review judgment here. Let the machine do the clerical crap.</div>
        </div>
        <button id="sign-out">Sign out</button>
      </header>

      <div id="loading" class="state">Checking authorization and loading Command Central…</div>
      <div id="denied" class="state hidden">This account is signed in but is not authorized for the XGL Editorial Room.</div>

      <section id="app" class="hidden">
        <div class="toolbar">
          <button data-filter="all" class="primary">All</button>
          <button data-filter="intelligence">Editorial Queue</button>
          <button data-filter="event">Events</button>
          <button id="refresh">Refresh</button>
        </div>
        <div id="queue" class="panel"></div>
      </section>
    </main>

    <script>
      import { createBrowserClient } from '../../lib/supabase';

      const supabase = createBrowserClient();
      const loading = document.querySelector('#loading');
      const denied = document.querySelector('#denied');
      const app = document.querySelector('#app');
      const queue = document.querySelector('#queue');
      const signOut = document.querySelector('#sign-out');
      const refresh = document.querySelector('#refresh');
      let activeFilter = 'all';
      let records = [];

      function escapeHtml(value = '') {
        return String(value).replace(/[&<>"']/g, (char) => ({
          '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
        }[char]));
      }

      function badge(value) {
        return value ? `<span class="tag">${escapeHtml(value)}</span>` : '';
      }

      function render() {
        const visible = records.filter((item) => activeFilter === 'all' || item.kind === activeFilter);
        queue.innerHTML = `
          <div class="row head">
            <div>Status</div><div>Item</div><div>Context</div><div>Actions</div>
          </div>
        ` + visible.map((item) => `
          <div class="row" data-id="${item.id}" data-kind="${item.kind}">
            <div>
              ${badge(item.status)}
              ${badge(item.urgency || item.priority)}
            </div>
            <div>
              <div class="headline">${escapeHtml(item.headline)}</div>
              <div class="small">${escapeHtml(item.summary || '')}</div>
            </div>
            <div class="small">
              ${badge(item.stream || item.event_type)}
              ${badge(item.geography || item.region)}
              ${item.source_url ? `<div><a href="${item.source_url}" target="_blank" rel="noreferrer">Open source</a></div>` : ''}
            </div>
            <div class="actions">
              <button data-action="approve" class="primary">Approve</button>
              <button data-action="verify">Verify</button>
              <button data-action="hold">Hold</button>
              <button data-action="unpublish">Unpublish</button>
              <button data-action="kill" class="danger">Kill</button>
            </div>
          </div>
        `).join('');
      }

      async function loadData() {
        const [{ data: intelligence, error: intelligenceError }, { data: events, error: eventsError }] = await Promise.all([
          supabase.from('intelligence_items')
            .select('id,headline,summary,stream,geography,source_quality,urgency,editorial_status,source_url,detected_at')
            .order('detected_at', { ascending: false })
            .limit(100),
          supabase.from('events')
            .select('id,name,public_summary,region,event_type,xgl_priority,publication_status,official_url,start_date,date_status')
            .order('start_date', { ascending: true, nullsFirst: false })
            .limit(100)
        ]);

        if (intelligenceError || eventsError) {
          loading.textContent = 'Could not load the editorial queue.';
          loading.classList.remove('hidden');
          return;
        }

        records = [
          ...(intelligence || []).map((x) => ({
            kind:'intelligence', id:x.id, headline:x.headline, summary:x.summary,
            stream:x.stream, geography:x.geography, urgency:x.urgency,
            status:x.editorial_status, source_url:x.source_url
          })),
          ...(events || []).map((x) => ({
            kind:'event', id:x.id, headline:x.name, summary:x.public_summary,
            event_type:x.event_type, region:x.region, priority:x.xgl_priority,
            status:x.publication_status, source_url:x.official_url
          }))
        ];
        render();
      }

      async function init() {
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) {
          window.location.replace('/command-central/login');
          return;
        }
        const role = user.app_metadata?.xgl_role;
        if (!['owner','admin','editor'].includes(role)) {
          loading.classList.add('hidden');
          denied.classList.remove('hidden');
          return;
        }
        loading.classList.add('hidden');
        app.classList.remove('hidden');
        await loadData();
      }

      queue?.addEventListener('click', async (event) => {
        const button = event.target.closest('button[data-action]');
        if (!button) return;
        const row = button.closest('[data-id]');
        const action = button.dataset.action;
        const target_id = row.dataset.id;
        const target_type = row.dataset.kind;

        button.disabled = true;
        const { error } = await supabase.rpc('command_central_action', {
          target_type,
          target_id,
          action_name: action,
          action_note: null,
          scheduled_for: null
        });
        button.disabled = false;

        if (error) {
          alert(error.message || 'Command Central action failed.');
          return;
        }
        await loadData();
      });

      document.querySelectorAll('[data-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter;
          document.querySelectorAll('[data-filter]').forEach((b) => b.classList.remove('primary'));
          button.classList.add('primary');
          render();
        });
      });

      refresh?.addEventListener('click', loadData);
      signOut?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.replace('/command-central/login');
      });

      init();
    </script>
  </body>
</html>
