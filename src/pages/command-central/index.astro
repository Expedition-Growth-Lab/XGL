---
import { createPublicClient } from '../../lib/supabase';
const supabase = createPublicClient();
const [{ data: events }, { data: intelligence }, { data: publicStatus }] = await Promise.all([
  supabase.from('events').select('id,slug,name,start_date,end_date,date_status,city,state,region,event_type,xgl_priority,registration_state,official_url,public_summary,xgl_relevance').eq('publication_status','published').order('start_date',{ascending:true,nullsFirst:false}),
  supabase.from('intelligence_items').select('id,slug,headline,stream,public_desk,watchtower_category,summary,urgency,published_at,source_url,why_xgl_cares').eq('editorial_status','published').order('published_at',{ascending:false}).limit(12),
  supabase.rpc('command_central_public_status')
]);
const rows=events??[];
const items=intelligence??[];
const status=publicStatus??{};
const pipelineItems=Number(status.pipeline_items??0);
const regulatorySources=Number(status.regulatory_sources??0);
const publicLandsSources=Number(status.public_lands_sources??0);
const eventSources=Number(status.event_sources??0);
const builderSources=Number(status.builder_sources??0);
const industrySources=Number(status.industry_sources??0);
const emergencySources=Number(status.emergency_sources??0);
const insideLabSources=Number(status.inside_lab_sources??0);
const confirmed=rows.filter((e)=>e.date_status==='confirmed');
const tba=rows.filter((e)=>e.date_status==='dates_tba');
const formatDate=(value)=>value?new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(new Date(value+'T12:00:00Z')):'TBA';
const signalLines=items.length?items.slice(0,6).map((s)=>s.headline):[
  confirmed[0]? `Next on the terrain: ${confirmed[0].name} — ${formatDate(confirmed[0].start_date)}`:null,
  `${confirmed.length} confirmed dates tracked`,
  `${tba.length} recurring events under date watch`
].filter(Boolean);
const hasFieldSignal=items.length>0;
const hasRegulatory=items.some((x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('regulatory'));
const hasPublicLands=items.some((x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('public lands'));
const hasBuilder=items.some((x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('builder'));
const hasIndustry=items.some((x)=>String(x.public_desk||x.stream||'').toLowerCase().includes('industry'));
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Command Central | Expedition Growth Lab</title><link rel="icon" type="image/webp" href="/assets/xgl-favicon.webp"><link rel="stylesheet" href="/institutional.css"><link rel="stylesheet" href="/command-central.css"></head>
<body class="command-central-app">
<header class="site-header"><div class="wrap"><a class="logo" href="/"><img src="/assets/xgl-txt-logo-clean.webp" alt="Expedition Growth Lab"></a><nav class="nav"><a href="/the-lab">The Lab</a><a class="active" href="/command-central">Command Central</a><a href="/one-rising-sun">One Rising Sun</a><a href="/faq">FAQ</a><a href="/about">About</a><a href="/contact">Contact</a></nav><a class="assessment-cta" href="/assessment">Start Assessment</a><details class="mobile-menu"><summary>Menu</summary><div class="mobile-menu-panel"><a href="/">Home</a><a href="/the-lab">The Lab</a><a href="/command-central">Command Central</a><a href="/command-central/field-signal">Field Signal</a><a href="/one-rising-sun">One Rising Sun</a><a href="/faq">FAQ</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/assessment">Start Assessment</a><a href="/command-central/login">Editorial Room</a></div></details></div></header>
<main>
<section class="hero"><div class="wrap"><div class="eyebrow">XGL Watchtower</div><h1 class="display">Command<br>Central.</h1><p class="hero-copy">A public intelligence center being built to help the overland world notice sooner, understand better, and act with more confidence.</p></div></section>

<section class="cc-foundation"><div class="wrap"><div class="cc-intro-grid"><div><div class="eyebrow">Foundation Release</div><h2 class="section-title">News is cheap.<br>Meaning is useful.</h2></div><div class="cc-intro-copy">Every desk is governed by one practical question: what does this mean for builders, employees, customers, clubs, and communities?</div></div>

<div class="cc-desks">
<a class="cc-desk" href="/command-central/field-signal"><h3>Field Signal</h3><p>Important developments distilled into a short, useful operating brief.</p><span class:list={["cc-status",(hasFieldSignal||pipelineItems)&&"live"]}>{hasFieldSignal?"Published Live":pipelineItems?"Editorial Pipeline Live":"Desk Forming"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#regulatory-watch"><h3>Regulatory Watch</h3><p>Rules, agencies, proposals, and compliance terrain translated for builders.</p><span class:list={["cc-status",(hasRegulatory||regulatorySources)&&"live"]}>{hasRegulatory?"Published Live":regulatorySources?`Monitoring Live · ${regulatorySources} sources`:"Desk Forming"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#public-lands-watch"><h3>Public Lands Watch</h3><p>Access, stewardship, closures, planning, and policy affecting where the community travels.</p><span class:list={["cc-status",(hasPublicLands||publicLandsSources)&&"live"]}>{hasPublicLands?"Published Live":publicLandsSources?`Monitoring Live · ${publicLandsSources} sources`:"Desk Forming"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#builder-intelligence"><h3>Builder Intelligence</h3><p>Signals from manufacturing, supply chains, safety, trade, technology, and the market.</p><span class:list={["cc-status",(hasBuilder||builderSources)&&"live"]}>{hasBuilder?"Published Live":builderSources?`Monitoring Live · ${builderSources} sources`:"Desk Forming"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#industry-headlines"><h3>Industry Headlines</h3><p>Curated news without the panic machine or the press-release confetti cannon.</p><span class:list={["cc-status",(hasIndustry||industrySources)&&"live"]}>{hasIndustry?"Published Live":industrySources?`Monitoring Live · ${industrySources} sources`:"Desk Forming"}</span></a>
<a class="cc-desk" href="#events"><h3>Event Calendar</h3><p>Shows, rallies, training, community gatherings, and useful dates across the field.</p><span class="cc-status live">{eventSources?`Live · ${eventSources} monitored sources`:"Live"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#emergency-response"><h3>Emergency Response</h3><p>Practical visibility when fires, storms, closures, recalls, or disruptions affect the community.</p><span class:list={["cc-status",emergencySources&&"live"]}>{emergencySources?`Monitoring Live · ${emergencySources} source${emergencySources===1?"":"s"}`:"Desk Forming"}</span></a>
<a class="cc-desk" href="/command-central/field-signal#inside-the-lab"><h3>Inside the Lab</h3><p>Field notes, methods, experiments, and lessons from the work itself.</p><span class:list={["cc-status",insideLabSources&&"live"]}>{insideLabSources?`Monitoring Live · ${insideLabSources} source${insideLabSources===1?"":"s"}`:"Desk Forming"}</span></a>
</div>

<div class="cc-signal-strip"><b>Field Signal</b>{signalLines.map((line)=><span>{line}</span>)}</div>
</div></section>

<section class="cc-watchtower"><div class="wrap cc-watchtower-inner"><div class="eyebrow gray">Six Permanent Desks</div><h2 class="section-title">The watchtower<br>behind the signal.</h2><p class="copy" style="font-size:18px">Business Watch, Regulatory Watch, Economic Watch, Technology Watch, Community Watch, and Environmental Watch provide the organizing structure behind articles, alerts, Builder Briefs, and Field Signals. The public desks above are how that intelligence gets translated into something usable.</p><a class="button" href="/command-central/field-signal" style="margin-top:20px">Open Field Signal</a></div></section>

<section class="cc-live-zone" id="latest"><div class="wrap"><div class="eyebrow">Latest Intelligence</div><h2>Field Signal</h2><p style="color:#aab3b5;max-width:760px;font-size:18px">Published intelligence from the Watchtower. Every item passes through the editorial room before it appears here.</p>
{items.length ? <div class="cc-feed">{items.slice(0,5).map((item)=><article class="cc-feed-item"><div class="cc-feed-stream">{item.public_desk||item.stream||'Field Signal'}</div><div><h3>{item.headline}</h3>{item.summary&&<p>{item.summary}</p>}</div><a href="/command-central/field-signal">Read Signal →</a></article>)}</div> : <div class="cc-empty">The Watchtower is online. Published Field Signals will appear here after editorial review.</div>}
</div></section>

<section class="cc-live-zone" id="events" style="padding-top:40px"><div class="wrap"><div class="eyebrow">Live Terrain</div><h2>Event Calendar</h2><p style="color:#aab3b5;max-width:760px;font-size:18px">Verified event intelligence from Command Central. Confirmed dates publish as confirmed; unknown dates remain honestly marked TBA.</p><div class="cc-live-grid">{rows.map((event)=><article class="cc-live-card"><div class="cc-live-date">{event.date_status==='confirmed'?formatDate(event.start_date):'Date Watch / TBA'}</div><h3>{event.name}</h3><div class="cc-live-meta">{[event.city,event.state,event.region].filter(Boolean).join(' · ')}</div><p>{event.public_summary}</p>{event.xgl_relevance&&<div class="why"><strong>Why XGL cares:</strong> {event.xgl_relevance}</div>}<a href={`/command-central/events/${event.slug}`}>Open Event Brief →</a></article>)}</div></div></section>
</main>
