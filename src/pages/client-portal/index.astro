---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="icon" type="image/webp" href="/assets/xgl-favicon.webp" />
    <link rel="stylesheet" href="/portal.css" />
    <title>Client Back Office | Expedition Growth Lab</title>
  </head>
  <body>
    <main class="portal-app-shell">
      <header class="portal-app-topbar">
        <a href="/" aria-label="Expedition Growth Lab home"><img class="portal-logo" src="/assets/xgl-txt-logo-clean.webp" alt="Expedition Growth Lab" /></a>
        <div class="portal-top-actions">
          <a class="portal-link" href="/portal">Account hub</a>
          <a id="staff-admin-link" class="portal-link portal-hidden" href="/client-portal/admin">Staff queue</a>
          <button id="sign-out" class="portal-button" type="button">Sign out</button>
        </div>
      </header>

      <div id="loading" class="portal-state">Opening your authorized workspace…</div>
      <div id="denied" class="portal-state error portal-hidden">This account does not currently hold active XGL client access. One Rising Sun membership does not create a client relationship. <a href="/portal">Return to your account hub.</a></div>
      <div id="error" class="portal-state error portal-hidden"></div>

      <section id="workspace" class="portal-hidden">
        <div class="portal-app-heading">
          <div>
            <div class="portal-eyebrow">Expedition Growth Lab · Secure client back office</div>
            <h1 id="organization-name">Client workspace</h1>
            <p>Projects, decisions, files, approvals, and next actions—kept in one accountable room.</p>
          </div>
          <div class="portal-heading-actions">
            <select id="organization-select" class="portal-select" aria-label="Organization"></select>
            <button class="portal-button primary" data-new="action" type="button">New action</button>
          </div>
        </div>

        <nav class="portal-app-nav" aria-label="Client workspace">
          <button class="active" data-view="overview">Action center</button>
          <button data-view="projects">Projects</button>
          <button data-view="actions">Actions</button>
          <button data-view="decisions">Decisions</button>
          <button data-view="documents">Documents</button>
          <button data-view="deliverables">Deliverables</button>
          <button data-view="approvals">Approvals</button>
          <button data-view="team">Team</button>
          <button data-view="activity">Activity</button>
        </nav>

        <div id="notice" class="portal-inline-notice portal-hidden" role="status"></div>
        <section id="view" class="portal-app-view" aria-live="polite"></section>
      </section>
    </main>

    <dialog id="portal-dialog" class="portal-dialog">
      <form id="entity-form" method="dialog">
        <div class="portal-dialog-head">
          <div><div class="portal-eyebrow">Add to workspace</div><h2 id="dialog-title">New item</h2></div>
          <button class="portal-dialog-close" value="cancel" aria-label="Close">×</button>
        </div>
        <div id="form-fields" class="portal-form-grid"></div>
        <div class="portal-dialog-actions"><button class="portal-button" value="cancel">Cancel</button><button id="save-entity" class="portal-button primary" value="default">Save</button></div>
      </form>
    </dialog>

    <script src="../../lib/client-portal.ts"></script>
  </body>
</html>
